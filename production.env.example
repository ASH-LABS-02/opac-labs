SITE_DOMAIN=
ADMIN_DOMAIN=
ACME_EMAIL=

# Public Firebase web app configuration (safe to embed in the browser build).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_APPCHECK_SITE_KEY=
ADMIN_APPCHECK_SITE_KEY=

# Local paths; Docker Compose mounts these files only into the web service.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# OPENAI_API_KEY_PATH=./secrets/openai-api-key.txt

CONTACT_RETENTION_DAYS=180
PROJECT_RETENTION_DAYS=365
CHAT_RETENTION_DAYS=180
