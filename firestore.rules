rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true && request.auth.token.email_verified == true; }

    match /adminAccess/{uid} {
      // Only the Admin SDK can provision or revoke staff access.
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'email'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email == request.auth.token.email
        && request.resource.data.get('phone', '') is string && request.resource.data.get('phone', '').size() <= 30
        && request.resource.data.get('createdAt', '') is string && request.resource.data.get('createdAt', '').size() <= 40
        && request.resource.data.get('updatedAt', '') is string && request.resource.data.get('updatedAt', '').size() <= 40;
      allow delete: if false;
    }
    match /chatHistory/{uid}/sessions/{sessionId} {
      // Session reads and writes are validated by the authenticated server API.
      allow read, write: if false;
    }
    match /orders/{id} {
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['Processing', 'Delivered', 'Cancelled'];
      allow create, delete: if false;
    }
    match /projectRequests/{id} {
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'reviewing', 'quoted', 'closed'];
      allow create, delete: if false;
    }
    match /contactMessages/{id} {
      allow read: if admin();
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'read', 'resolved'];
      allow create, delete: if false;
    }
  }
}
