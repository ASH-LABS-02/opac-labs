{
    email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    handle /api/health {
        respond 404
    }
    handle {
        reverse_proxy web:3000
    }
    log {
        output stdout
        format json
    }
}

{$ADMIN_DOMAIN} {
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy admin:80
    log {
        output stdout
        format json
    }
}
