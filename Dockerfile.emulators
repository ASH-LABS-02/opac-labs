FROM node:22-bookworm-slim AS firebase-cli
RUN npm install --global firebase-tools@14

FROM eclipse-temurin:21-jre-noble
COPY --from=firebase-cli /usr/local /usr/local
WORKDIR /app
COPY firebase.docker.json firestore.rules firestore.indexes.json ./
COPY scripts/start-emulators.sh ./scripts/start-emulators.sh
RUN chmod +x ./scripts/start-emulators.sh
VOLUME /data
EXPOSE 4000 8080 9099
CMD ["./scripts/start-emulators.sh"]
