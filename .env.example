# Copy to .env.local. Never commit actual credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/opac_labs
MONGODB_DB=opac_labs
# true for Atlas/replica sets; false only for a standalone development server.
MONGODB_TRANSACTIONS=false
BETTER_AUTH_URL=http://localhost:3007
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Brevo SMTP Login/key (not an API key), or another SMTP provider. No SMTP means local-only email logs
# in development; production refuses account email without a real transport.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="OPAC Labs <your-business-email@example.com>"
# Optional staff alerts: private bot token and the owner's paired private chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPAC_PAID_AI_ENABLED=false
OPENAI_API_KEY=
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_PROVIDER=
